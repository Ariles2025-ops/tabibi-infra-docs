{
  "realm": "tabibi",
  "enabled": true,
  "displayName": "Tabibi",
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(10) and digits(1) and lowerCase(1) and upperCase(1) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "rememberMe": false,
  "roles": {
    "realm": [
      { "name": "PATIENT", "description": "Patient : prise de rendez-vous, ordonnances, messagerie, avis, Dawini" },
      { "name": "MEDECIN", "description": "Medecin : agenda, creneaux, ordonnances, teleconsultations, cabinet" },
      { "name": "SECRETAIRE", "description": "Secretaire rattachee a un ou plusieurs cabinets" },
      { "name": "ADMIN", "description": "Administrateur de la plateforme : candidatures, moderation, audit" },
      { "name": "PHARMACIE", "description": "Pharmacie : reponses aux besoins de medicaments (Dawini)" }
    ]
  },
  "clients": [
    {
      "clientId": "tabibi-web",
      "name": "Tabibi web (Angular)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*", "https://tabibi.example/*"],
      "webOrigins": ["http://localhost:4200", "https://tabibi.example"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "tabibi-mobile",
      "name": "Tabibi mobile (Flutter)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["dz.tabibi.app:/oauthredirect"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
